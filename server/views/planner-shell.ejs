<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#173e38">
  <title><%= title %></title>
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/static/css/planner.css">
  <script src="/static/js/planner.js" defer></script>
</head>
<body>
<%
 const kinds = { all: 'All ideas', destination: 'Destinations', stay: 'Places to stay', transport: 'Getting around', activity: 'Things to do', link: 'Useful links' };
 const singular = { destination: 'Destination', stay: 'Place to stay', transport: 'Transport', activity: 'Activity', link: 'Useful link' };
 const statuses = { considering: 'Exploring', shortlisted: 'Shortlisted', selected: 'Selected', booked: 'Booked', eliminated: 'Passed on' };
 const h = {
   kinds, singular, statuses,
   money: (amount, currency = 'CAD') => new Intl.NumberFormat('en-CA', { style: 'currency', currency, maximumFractionDigits: 2 }).format(Number(amount)),
   date: value => value ? new Date(value).toLocaleDateString('en-CA', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : 'Dates open',
  initials: name => (name || '?').replace(/[()]/g, '').trim().split(/\s+/).slice(0, 2).map(s => s[0]).join('').toUpperCase(),
   host: url => { try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return ''; } },
   kindIcon: kind => ({ destination: 'pin', stay: 'home', transport: 'car', activity: 'sun', link: 'link', all: 'grid' }[kind] || 'grid')
 };
 const signedIn = viewer.isOrganizer || viewer.participantId;
 const workspace = signedIn && !['login', 'join'].includes(view);
 const boardActive = ['board','idea','idea-form','compare','share'].includes(view);
%>
<%- include('planner/icons') %>
<a class="skip-link" href="#main">Skip to content</a>
<% if (workspace) { %>
<div class="app-shell">
  <aside class="sidebar" aria-label="Main navigation">
    <a class="brand" href="/plans"><svg class="brand-mark" aria-hidden="true"><use href="#i-compass"/></svg><span>Hotel Tracker<span class="brand-sub">Good trips start together.</span></span></a>
    <nav class="primary-nav" aria-label="Workspace">
      <a href="/plans" class="nav-link <%= view === 'plans' ? 'active' : '' %>" <%- view === 'plans' ? 'aria-current="page"' : '' %>><svg class="icon" aria-hidden="true"><use href="#i-grid"/></svg>My trips</a>
      <% if (data.trip && data.trip.id) { %>
      <div class="nav-trip"><%= data.trip.name %></div>
      <a href="/plans/<%= data.trip.id %>" class="nav-link <%= boardActive ? 'active' : '' %>" <%- view === 'board' ? 'aria-current="page"' : '' %>><svg class="icon" aria-hidden="true"><use href="#i-compass"/></svg>Research</a>
      <a href="/plans/<%= data.trip.id %>/selected" class="nav-link <%= view === 'selected' ? 'active' : '' %>" <%- view === 'selected' ? 'aria-current="page"' : '' %>><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>Selected plan</a>
      <% } %>
    </nav>
    <div class="viewer"><span class="avatar"><%= h.initials(viewer.name) %></span><span class="viewer-name"><strong><%= viewer.name %></strong><small><%= viewer.isOrganizer ? 'Trip organizer' : 'Travel companion' %></small></span><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="icon-button light" aria-label="Sign out" title="Sign out"><svg class="icon" aria-hidden="true"><use href="#i-logout"/></svg></button></form></div>
  </aside>
  <div class="workspace <%= view === 'board' ? 'board-workspace' : '' %>">
    <header class="topbar"><div class="breadcrumb"><a href="/plans">My trips</a><% if (data.trip && data.trip.id) { %><span aria-hidden="true">/</span><a href="/plans/<%= data.trip.id %>"><%= data.trip.name %></a><% } %></div><span class="privacy"><svg class="icon small" aria-hidden="true"><use href="#i-lock"/></svg>Private group space</span></header>
    <main id="main" class="main-content">
      <% if (error && view !== 'error') { %><div class="notice error" role="alert"><strong>Let’s fix that.</strong> <%= error %><% if (data.errorTarget) { %> <a href="#<%= data.errorTarget %>"><%= data.errorTargetLabel %></a><% } %></div><% } %>
      <%- include('planner/' + view, { data, viewer, csrfToken, error, h }) %>
    </main>
    <footer class="app-footer"><span>Hotel Tracker · V1</span></footer>
  </div>
</div>
<% } else { %>
<div class="welcome-shell"><header class="welcome-header"><a href="/plans" class="brand"><svg class="brand-mark" aria-hidden="true"><use href="#i-compass"/></svg><span>Hotel Tracker</span></a><span>Plan something worth sharing.</span></header><main id="main" class="welcome-main"><% if (error && view !== 'error') { %><div class="notice error" role="alert"><%= error %></div><% } %><%- include('planner/' + view, { data, viewer, csrfToken, error, h }) %></main><footer class="welcome-footer">A private place for your next shared adventure.</footer></div>
<% } %>
<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
</body>
</html>