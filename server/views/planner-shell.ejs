<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#173e38">
  <title><%= title %></title>
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/static/css/planner.css">
  <script src="/static/js/planner.js" defer></script>
</head>
<body>
<%
 const kinds = { all: 'By destination', destination: 'Destinations', stay: 'Places to stay', transport: 'Getting around', activity: 'Things to do', link: 'Other' };
 const plural = { stay: 'Stays', transport: 'Transport', activity: 'Activities' };
 const singular = { destination: 'Destination', stay: 'Place to stay', transport: 'Transport', activity: 'Activity', link: 'Other' };
 const statuses = { considering: 'Exploring', shortlisted: 'Shortlisted', selected: 'Selected', booked: 'Booked', eliminated: 'Passed on' };
 const fmtMoney = (amount, currency = 'CAD') => new Intl.NumberFormat('en-CA', { style: 'currency', currency, minimumFractionDigits: Number(amount) % 1 ? 2 : 0, maximumFractionDigits: 2 }).format(Number(amount));
 const display = locals.money;
 const travelers = display && display.travelers;
 const h = {
   kinds, singular, plural, statuses,
   money: fmtMoney,
   display,
   travelers,
   // Rough share of a group total: total ÷ trip travelers, whole units. Empty when the group size is unset.
   // "+" marks a lower bound when part of the total still has no quote.
   each: (amount, currency, incomplete = false) => travelers ? '≈ ' + fmtMoney(Math.round(Number(amount) / travelers), currency) + (incomplete ? '+' : '') + ' / person' : '',
   // A quote in the viewer's display currency: converted (≈, whole units) when a rate is known.
   price: (amount, currency) => {
     const converted = display && currency !== display.currency ? display.convert(Number(amount), currency) : null;
     if (converted == null) return { text: fmtMoney(amount, currency), currency, converted: false, title: '', each: h.each(amount, currency) };
     return { text: '≈ ' + fmtMoney(Math.round(converted), display.currency), currency: display.currency, converted: true, each: h.each(converted, display.currency),
       title: `Quoted ${fmtMoney(amount, currency)} ${currency} · ECB rate of ${h.date(display.date)}` };
   },
   date: value => value ? new Date(value).toLocaleDateString('en-CA', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : 'Dates open',
   when: value => new Date(value).toLocaleString('en-CA', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: 'UTC' }) + ' UTC',
  initials: name => (name || '?').replace(/[()]/g, '').trim().split(/\s+/).slice(0, 2).map(s => s[0]).join('').toUpperCase(),
   host: url => { try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return ''; } },
   kindIcon: kind => ({ destination: 'pin', stay: 'home', transport: 'car', activity: 'sun', link: 'link', all: 'grid' }[kind] || 'grid')
 };
 const signedIn = viewer.userId || viewer.participantId;
 const workspace = signedIn && !['login', 'join'].includes(view);
 const boardActive = ['board','idea','idea-form','compare','share','trip-edit'].includes(view);
%>
<%- include('planner/icons') %>
<a class="skip-link" href="#main">Skip to content</a>
<% if (workspace) { %>
<div class="app-shell">
  <aside class="sidebar" aria-label="Main navigation">
    <a class="brand" href="/plans"><svg class="brand-mark" aria-hidden="true"><use href="#i-compass"/></svg><span>PlanTrip<span class="brand-sub">Good trips start together.</span></span></a>
    <div class="primary-nav">
      <nav aria-label="Workspace">
        <a href="/plans" class="nav-link <%= data.trip ? 'workspace-return' : '' %> <%= view === 'plans' ? 'active' : '' %>" <%- view === 'plans' ? 'aria-current="page"' : '' %>><svg class="icon" aria-hidden="true"><use href="#i-<%= data.trip ? 'arrow' : 'grid' %>"/></svg>My trips</a>
      </nav>
      <% if (data.trip && data.trip.id) { %>
      <section class="sidebar-trip" aria-labelledby="nav-trip-name">
        <header class="sidebar-trip-context">
          <h2 class="nav-trip" id="nav-trip-name"><%= data.trip.name %></h2>
        </header>
        <nav class="trip-nav-links" aria-label="Trip sections">
          <a href="/plans/<%= data.trip.id %>" class="nav-link <%= boardActive ? 'active' : '' %>" <%- boardActive ? `aria-current="${view === 'board' ? 'page' : 'location'}"` : '' %>>Research</a>
          <a href="/plans/<%= data.trip.id %>/selected" class="nav-link <%= view === 'selected' ? 'active' : '' %>" <%- view === 'selected' ? 'aria-current="page"' : '' %>>Selected plan</a>
        </nav>
      </section>
      <% } %>
    </div>
    <div class="viewer"><span class="avatar"><%= h.initials(viewer.name) %></span><span class="viewer-name"><strong><%= viewer.name %></strong><small><%= viewer.isOrganizer ? 'Trip organizer' : viewer.userId && !boardActive ? 'Organizer' : 'Trip member' %></small></span><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="icon-button light" aria-label="Sign out" title="Sign out"><svg class="icon" aria-hidden="true"><use href="#i-logout"/></svg></button></form></div>
  </aside>
  <div class="workspace <%= view === 'board' ? 'board-workspace' : '' %>">
    <header class="topbar"><div class="breadcrumb"><a href="/plans">My trips</a><% if (data.trip && data.trip.id) { %><span aria-hidden="true">/</span><a href="/plans/<%= data.trip.id %>"><%= data.trip.name %></a><% } %></div><span class="privacy"><svg class="icon small" aria-hidden="true"><use href="#i-lock"/></svg>Private group space</span></header>
    <main id="main" class="main-content">
      <% if (error && view !== 'error') { %><div class="notice error" role="alert"><strong>Let’s fix that.</strong> <%= error %><% if (data.errorTarget) { %> <a href="#<%= data.errorTarget %>"><%= data.errorTargetLabel %></a><% } %></div><% } %>
      <%- include('planner/' + view, { data, viewer, csrfToken, error, h }) %>
    </main>
    <footer class="app-footer"><span>PlanTrip · V1</span></footer>
  </div>
</div>
<% } else { %>
<div class="welcome-shell"><header class="welcome-header"><a href="/plans" class="brand"><svg class="brand-mark" aria-hidden="true"><use href="#i-compass"/></svg><span>PlanTrip</span></a><span>Plan something worth sharing.</span></header><main id="main" class="welcome-main"><% if (error && view !== 'error') { %><div class="notice error" role="alert"><%= error %></div><% } %><%- include('planner/' + view, { data, viewer, csrfToken, error, h }) %></main><footer class="welcome-footer">A private place for your next shared adventure.</footer></div>
<% } %>
<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
</body>
</html>