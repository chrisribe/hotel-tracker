<% const base = '/plans/' + data.trip.id; %>
<a class="back-link" href="<%= base %>"><svg class="icon" aria-hidden="true"><use href="#i-back"/></svg>Back to research board</a>
<div class="page-heading"><div><h1>Compare options</h1><p>Compare 2–4 options. This doesn’t add them to the plan.</p></div></div>
<% if (data.trip.is_demo) { %><div class="demo-note"><span class="badge sample">Sample comparison</span><span>Illustrative options and quotes—not verified offers.</span></div><% } %>
<form class="comparison-kind" action="<%= base %>/compare" method="get"><label for="comparison-kind">Category<select id="comparison-kind" name="kind"><% Object.entries(h.singular).forEach(([kind,label]) => { %><option value="<%= kind %>" <%= data.kind === kind ? 'selected' : '' %>><%= h.kinds[kind] %></option><% }) %></select></label><button class="button secondary">Change category</button></form>
<% if (data.candidates.length < 2) { %>
<div class="empty-state"><h2>Add another option to compare</h2><p>Choose a different category or add another idea.</p><a class="button primary" href="<%= base %>/ideas/new">Add idea</a></div>
<% } else if (data.candidates.length > 2 || !data.items.length) { %>
<details class="comparison-picker" <%= !data.items.length ? 'open' : '' %>><summary><%= data.items.length ? 'Change the comparison' : 'Choose your options' %><span class="fine-print">2–4 at a time</span></summary>
  <form action="<%= base %>/compare" method="get" data-compare-form><input type="hidden" name="kind" value="<%= data.kind %>"><fieldset><legend class="sr-only">Choose two to four <%= h.kinds[data.kind].toLowerCase() %></legend><div class="comparison-choices">
    <% data.candidates.forEach(item => { %><label class="comparison-choice"><input type="checkbox" name="ids" value="<%= item.id %>" <%= data.items.some(i => i.id === item.id) ? 'checked' : '' %>><span><strong><%= item.title %></strong><span><%= item.location || h.singular[item.kind] %> · <%= h.statuses[item.status] %></span><span><%= item.cost !== null ? h.money(item.cost,item.currency) + ' ' + item.currency + ' ' + h.basis[item.cost_basis] : 'Quote not recorded' %></span></span></label><% }) %>
  </div></fieldset><div class="form-actions"><button class="button primary">Compare options<svg class="icon" aria-hidden="true"><use href="#i-compare"/></svg></button><span class="fine-print" data-compare-count aria-live="polite"><%= data.items.length %> of 4 chosen</span></div></form>
</details>
<% } %>
<% if (data.items.length) { %>
<div class="comparison-guidance"><p class="fine-print">Check matching dates and fees. Quotes aren’t live or currency-converted. Scroll sideways to see every option.</p></div>
<div class="comparison-scroll" role="region" aria-label="Side-by-side option comparison" tabindex="0">
<table class="comparison-table">
  <caption class="sr-only"><%= h.kinds[data.kind] %> comparison: <%= data.items.map(i=>i.title).join(', ') %></caption>
  <thead><tr><th scope="col">What matters</th><% data.items.forEach(item => { %><th scope="col"><% if (item.cover_image) { %><%- include('photo',{photo:item.cover_image,photoTitle:item.title,photoClass:'comparison-photo'}) %><% } %><a href="<%= base %>/ideas/<%= item.id %>"><%= item.title %></a><span class="badge <%= item.status %>"><%= h.statuses[item.status] %></span></th><% }) %></tr></thead>
  <tbody>
    <tr><th scope="row">Location</th><% data.items.forEach(item => { const d=data.destinations.find(d=>d.id===item.destination_id); %><td><%= item.location || (d && d.title) || 'Not recorded' %></td><% }) %></tr>
    <% if (['stay','transport','activity'].includes(data.kind) || data.items.some(i => i.cost !== null)) { %><tr><th scope="row">Total quote</th><% data.items.forEach(item => { %><td><% if (item.cost !== null) { %><strong class="compare-price"><%= h.money(item.cost,item.currency) %></strong><span class="cell-note"><%= item.currency %> · <%= h.basis[item.cost_basis] %> · <%= item.price_kind === 'quoted' ? 'quoted' : 'estimate' %></span><% } else { %><span class="cell-unknown">Still to check</span><% } %></td><% }) %></tr><% } %>
    <% if (['stay','transport'].includes(data.kind) || data.items.some(i => i.capacity)) { %><tr><th scope="row">Capacity</th><% data.items.forEach(item => { %><td><%= item.capacity ? item.capacity + ' people' : 'Not recorded' %></td><% }) %></tr><% } %>
    <tr><th scope="row">Why consider it?</th><% data.items.forEach(item => { %><td><p class="compare-notes"><%= item.notes || 'No notes yet.' %></p></td><% }) %></tr>
    <tr><th scope="row">Sources & takeaways</th><% data.items.forEach(item => { %><td><% if (!item.sources.length) { %><span class="cell-unknown">No supporting sources yet</span><% } %><ul class="compare-sources"><% item.sources.forEach(source => { %><li><a href="<%= source.url %>" target="_blank" rel="noopener noreferrer"><%= source.label %><span class="sr-only"> (opens in a new tab)</span></a><% if (source.takeaway) { %><p><%= source.takeaway %></p><% } %></li><% }) %></ul></td><% }) %></tr>
    <tr><th scope="row">Group response</th><% data.items.forEach(item => { %><td><div class="compare-response"><svg class="icon small" aria-hidden="true"><use href="#i-heart"/></svg><%= item.vote_count %> interested</div><a href="<%= base %>/ideas/<%= item.id %>#discussion"><%= item.comment_count %> comments</a></td><% }) %></tr>
    <tr><th scope="row">Next step</th><% data.items.forEach(item => { %><td><a class="text-link" href="<%= base %>/ideas/<%= item.id %>">Open full research<svg class="icon small" aria-hidden="true"><use href="#i-arrow"/></svg></a><% if (viewer.isOrganizer && !['selected','booked'].includes(item.status)) { %><form method="post" action="<%= base %>/ideas/<%= item.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="selected"><input type="hidden" name="returnTo" value="selected"><button class="button primary">Select for plan<span class="sr-only">: <%= item.title %></span></button></form><% } else if (['selected','booked'].includes(item.status)) { %><span class="cell-note">Already in the selected plan</span><% } else { %><span class="cell-note">Your organizer confirms the selection.</span><% } %></td><% }) %></tr>
  </tbody>
</table></div>
<% } %>