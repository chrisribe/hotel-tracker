<%
 const v = data.values || {}, trip = data.trip, editing = Boolean(data.item);
 const hasError = typeof error !== 'undefined' && Boolean(error);
 const hasValue = value => value != null && String(value) !== '';
 const detailsOpen = hasError || [v.location, v.destination_id, v.notes].some(hasValue);
 const tripCurrency = trip.currency || 'CAD';
 const quoteOpen = hasError || [v.cost, v.capacity].some(hasValue) || (hasValue(v.currency) && v.currency !== tripCurrency);
%>
<a class="back-link" href="/plans/<%= trip.id %><%= editing ? '/ideas/' + data.item.id : '' %>"><svg class="icon" aria-hidden="true"><use href="#i-back"/></svg><%= editing ? 'Back to idea' : 'Back to research board' %></a>
<div class="page-heading"><div><h1><%= editing ? 'Edit idea' : 'Add an idea' %></h1></div></div>
<form method="post" action="<%= data.formAction %>" class="idea-editor editor-form stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <fieldset class="kind-picker"><legend>What kind of idea?</legend><% Object.entries(h.singular).forEach(([kind,label]) => { %><label><input type="radio" name="kind" value="<%= kind %>" <%= (v.kind || 'destination') === kind ? 'checked' : '' %>><span><svg class="icon" aria-hidden="true"><use href="#i-<%= h.kindIcon(kind) %>"/></svg><%= label %></span></label><% }) %></fieldset>
  <label for="idea-title">Name<input id="idea-title" name="title" required maxlength="160" placeholder="e.g. A house by the coast" value="<%= v.title || '' %>"></label>
  <% if (!editing) { %>
  <label for="idea-url">First source URL <span class="optional">Optional</span><input type="url" id="idea-url" name="url" maxlength="2048" placeholder="https://…" value="<%= v.url || '' %>"></label>
  <details class="editor-disclosure" <%= hasError || [v.source_label, v.takeaway].some(hasValue) ? 'open' : '' %>><summary>Source label & takeaway <span class="optional">Optional</span></summary><div class="stack-form">
    <label for="source-label">Source label<input id="source-label" name="source_label" maxlength="120" placeholder="e.g. Airbnb listing, local travel guide" value="<%= v.source_label || '' %>"></label>
    <label for="source-takeaway">Takeaway<textarea id="source-takeaway" name="takeaway" rows="3" maxlength="2000" placeholder="What did you learn?"><%= v.takeaway || '' %></textarea></label>
  </div></details>
  <% } %>
  <details class="editor-disclosure" <%= detailsOpen ? 'open' : '' %>><summary>Location & notes <span class="optional">Optional</span></summary><div class="stack-form">
    <div class="form-row"><label for="idea-location">Location<input id="idea-location" name="location" maxlength="200" placeholder="City, area, or region" value="<%= v.location || '' %>"></label><label for="idea-destination" data-destination-field>Related destination<select id="idea-destination" name="destination_id"><option value="">Not tied to a destination yet</option><% data.destinations.filter(d => !data.item || d.id !== data.item.id).forEach(d => { %><option value="<%= d.id %>" <%= String(v.destination_id) === String(d.id) ? 'selected' : '' %>><%= d.title %></option><% }) %></select></label></div>
    <label for="idea-notes">Notes<textarea id="idea-notes" name="notes" rows="4" maxlength="10000" placeholder="What should the group know?"><%= v.notes || '' %></textarea></label>
  </div></details>
  <details class="editor-disclosure" <%= quoteOpen ? 'open' : '' %>><summary>Quote & capacity <span class="optional">Optional</span></summary><div class="stack-form"><div class="form-row three">
    <label for="idea-cost">Total quote<input id="idea-cost" type="number" name="cost" min="0" max="999999999999.99" step="0.01" placeholder="Not known yet" value="<%= v.cost == null ? '' : v.cost %>"></label>
    <label for="idea-currency">Currency<select id="idea-currency" name="currency"><% ['CAD','USD','EUR','GBP'].forEach(currency => { %><option value="<%= currency %>" <%= (v.currency || tripCurrency) === currency ? 'selected' : '' %>><%= currency %></option><% }) %></select></label>
    <label for="idea-capacity">Capacity<input id="idea-capacity" type="number" name="capacity" min="1" max="100000" step="1" placeholder="People" value="<%= v.capacity == null ? '' : v.capacity %>"></label>
  </div><p class="fine-print">Total for the stay, rental, or activity—not per night or person. Leave blank if unknown.</p></div></details>
  <p class="fine-print">Don’t include payment details, passports, or private booking documents.</p>
  <div class="form-actions"><button class="button primary"><%= editing ? 'Save changes' : 'Add idea' %></button><a class="button subtle" href="/plans/<%= trip.id %><%= editing ? '/ideas/' + data.item.id : '' %>">Cancel</a></div>
</form>