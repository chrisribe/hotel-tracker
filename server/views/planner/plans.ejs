<% const values = data.values || {}; %>
<div class="page-heading"><div><h1>Good trips start here.</h1><p>A few ideas, your favorite people, and somewhere new to go.</p></div><% if (viewer.isOrganizer) { %><a class="button primary" href="#new-trip"><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg>New trip</a><% } %></div>
<section aria-labelledby="trips-heading"><div class="section-heading"><h2 id="trips-heading">Your shared plans <span class="count"><%= data.trips.length %></span></h2><span class="muted">From “what if” to “we’re going”</span></div>
<% if (!data.trips.length) { %><div class="empty-state"><svg class="empty-icon" aria-hidden="true"><use href="#i-compass"/></svg><h3>Every trip starts with an idea.</h3><p>Create a trip even if the destination is still wide open. Gather your people, then figure it out together.</p><a class="button primary" href="#new-trip">Plan your first trip<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></div><% } else { %>
<div class="trip-grid"><% data.trips.forEach((trip, index) => { %><article class="trip-tile"><div class="trip-tile-top"><span class="trip-symbol tone-<%= index % 3 %>"><svg aria-hidden="true"><use href="#i-compass"/></svg></span><% if (trip.is_demo) { %><span class="badge sample">Sample workspace</span><% } else { %><span class="badge considering">Planning together</span><% } %></div><h3><a href="/plans/<%= trip.id %>"><%= trip.name %></a></h3><p class="trip-description"><%= trip.description || 'A blank page for your next adventure. Start collecting possibilities.' %></p><div class="trip-facts"><span><svg class="icon small" aria-hidden="true"><use href="#i-calendar"/></svg><%= h.date(trip.travel_start) %></span><span><svg class="icon small" aria-hidden="true"><use href="#i-people"/></svg><%= trip.member_count %> <%= trip.member_count === 1 ? 'person' : 'people' %></span></div><div class="trip-tile-footer"><span><%= trip.item_count %> research <%= trip.item_count === 1 ? 'idea' : 'ideas' %></span><a class="text-link" href="/plans/<%= trip.id %>">Open board<svg class="icon small" aria-hidden="true"><use href="#i-arrow"/></svg></a></div></article><% }) %></div>
<% } %></section>
<% if (viewer.isOrganizer) { %><div class="plans-bottom"><section id="new-trip" class="new-trip-section"><h2>Make room for a new adventure.</h2><p class="muted">A working title is enough. You can leave the destination and dates open.</p><form method="post" action="/plans" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="trip-name">Trip name<input id="trip-name" name="name" required maxlength="120" placeholder="e.g. A week away with friends" value="<%= values.name || '' %>"></label><label for="trip-description">What are you thinking? <span class="optional">Optional</span><textarea id="trip-description" name="description" rows="3" maxlength="5000" aria-describedby="description-hint" placeholder="Beach or mountains? A big house, good food, a little exploring…"><%= values.description || '' %></textarea><span class="fine-print" id="description-hint">Where, who, budget, must-haves. The <%= ASSISTANT_NAME %> reads this too.</span></label><div class="form-row"><label for="travel-start">From <span class="optional">Optional</span><input type="date" id="travel-start" name="travel_start" value="<%= values.travel_start || '' %>"></label><label for="travel-end">Until <span class="optional">Optional</span><input type="date" id="travel-end" name="travel_end" value="<%= values.travel_end || '' %>"></label></div><label for="trip-currency">Trip currency<select id="trip-currency" name="currency"><% ['CAD','EUR','USD','GBP'].forEach(currency => { %><option value="<%= currency %>" <%= (values.currency || 'CAD') === currency ? 'selected' : '' %>><%= currency %></option><% }) %></select><span class="fine-print">New quotes default to it. Quotes in other currencies stay separate, never converted.</span></label><label for="trip-travelers">Travelers <span class="optional">Optional</span><input type="number" id="trip-travelers" name="travelers" min="1" max="100" value="<%= values.travelers || '' %>"><span class="fine-print">Used to show a rough per-person share of each total quote.</span></label><label class="check-row" for="start-research"><input type="checkbox" id="start-research" name="start_research" value="1" <%= values.start_research ? 'checked' : '' %>><span>Let the <%= ASSISTANT_NAME %> start researching<span class="fine-print">Destinations, stays, flights and activities from your description, with prices, links and photos.</span></span></label><div><button class="button primary">Create trip<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></button></div></form></section><aside class="sample-prompt"><svg class="sample-compass" aria-hidden="true"><use href="#i-compass"/></svg><h2>Take a look around.</h2><p>Explore a sample group trip with destination ideas, a shared house, and a rental car. Try the tools before starting your own.</p><p class="fine-print">All sample options and quotes are illustrative, not actual offers.</p><form method="post" action="/plans/demo"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary">Open sample trip<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></button></form></aside></div><% } %>