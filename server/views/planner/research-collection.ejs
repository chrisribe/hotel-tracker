<% const sourceValues = data.sourceValues || {}, imageValues = data.imageValues || {}; %>
<section class="collection-section" id="sources" aria-labelledby="sources-title">
  <div class="section-heading"><h2 id="sources-title">Sources <span class="count"><%= item.sources.length %></span></h2></div>
  <% if (!item.sources.length) { %><p class="collection-empty">No sources yet.</p><% } %>
  <div class="source-list">
  <% item.sources.forEach(source => { const editable = viewer.isOrganizer || source.created_by === viewer.participantId; const editing = data.errorCollection === 'sources' && data.referenceAction === 'edit' && String(sourceValues.id) === String(source.id); %>
    <article class="source-entry">
      <div class="source-entry-heading"><svg class="icon" aria-hidden="true"><use href="#i-link"/></svg><div><h3><a href="<%= source.url %>" target="_blank" rel="noopener noreferrer"><%= source.label %><svg class="icon small" aria-hidden="true"><use href="#i-external"/></svg><span class="sr-only"> (opens in a new tab)</span></a></h3><span class="fine-print"><%= h.host(source.url) %> · Added by <%= source.author_name || 'Organizer' %></span></div></div>
      <% if (source.takeaway) { %><p class="source-takeaway"><%= source.takeaway %></p><% } %>
      <% if (editable) { %>
      <details class="reference-edit" <%= editing ? 'open' : '' %>><summary>Edit source<span class="sr-only"> <%= source.label %></span></summary>
        <form method="post" action="<%= path %>/sources/<%= source.id %>/edit" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><%- include('reference-fields', {type:'source',prefix:'source-'+source.id,values:editing ? sourceValues : source,validation:data.referenceError}) %><div><button class="button secondary">Save source</button></div></form>
        <form class="remove-reference" method="post" action="<%= path %>/sources/<%= source.id %>/delete" data-confirm="Remove this source? The idea and its discussion will stay."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button danger subtle">Remove source</button></form>
      </details><% } %>
    </article>
  <% }) %>
  </div>
  <details class="add-reference" id="add-source" <%= data.errorCollection === 'sources' && data.referenceAction === 'add' && !sourceValues.id ? 'open' : '' %>><summary><svg class="icon disclosure-icon" aria-hidden="true"><use href="#i-chevron"/></svg>Add a source<span class="fine-print"><%= item.sources.length %>/20</span></summary>
    <form method="post" action="<%= path %>/sources" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><%- include('reference-fields', {type:'source',prefix:'new-source',values:!sourceValues.id ? sourceValues : {},validation:data.referenceError}) %><div><button class="button primary" <%= item.sources.length >= 20 ? 'disabled' : '' %>>Save source</button></div></form>
  </details>
</section>
<section class="collection-section" id="photos" aria-labelledby="photos-title">
  <div class="section-heading"><h2 id="photos-title">Photos <span class="count"><%= item.images.length %></span></h2></div>
  <% if (!item.images.length) { %><p class="collection-empty">No photos yet.</p><% } %>
  <div class="photo-gallery"><% item.images.forEach(image => { const editable = viewer.isOrganizer || image.created_by === viewer.participantId; const editing = data.errorCollection === 'images' && data.referenceAction === 'edit' && String(imageValues.id) === String(image.id); %>
    <article class="gallery-entry">
      <a href="<%= image.url %>" target="_blank" rel="noopener noreferrer" aria-label="Open full image: <%= image.caption || item.title %>"><%- include('photo', {photo:image,photoTitle:item.title,photoClass:'gallery-photo'}) %></a>
      <div class="photo-caption"><% if (image.is_cover) { %><span class="badge selected">Cover photo</span><% } %><p><%= image.caption || 'Photo for ' + item.title %></p><span class="fine-print">Added by <%= image.author_name || 'Organizer' %></span><% if (image.source_url) { %><a class="text-link" href="<%= image.source_url %>" target="_blank" rel="noopener noreferrer">Image source<svg class="icon small" aria-hidden="true"><use href="#i-external"/></svg><span class="sr-only"> (opens in a new tab)</span></a><% } %></div>
      <% if (data.canEdit && !image.is_cover) { %><form method="post" action="<%= path %>/images/<%= image.id %>/cover"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary full-width">Use as cover<span class="sr-only">: <%= image.caption || image.id %></span></button></form><% } %>
      <% if (editable) { %><details class="reference-edit" <%= editing ? 'open' : '' %>><summary>Edit photo<span class="sr-only"> <%= image.caption || image.id %></span></summary>
        <form method="post" action="<%= path %>/images/<%= image.id %>/edit" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><%- include('reference-fields',{type:'image',prefix:'image-'+image.id,values:editing ? imageValues : image,validation:data.referenceError}) %><button class="button secondary">Save photo changes</button></form>
        <form class="remove-reference" method="post" action="<%= path %>/images/<%= image.id %>/delete" data-confirm="Remove this image reference? The source image is not deleted."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button danger subtle">Remove photo</button></form>
      </details><% } %>
    </article>
  <% }) %></div>
  <details class="add-reference" id="add-photo" <%= data.errorCollection === 'images' && data.referenceAction === 'add' && !imageValues.id ? 'open' : '' %>><summary><svg class="icon disclosure-icon" aria-hidden="true"><use href="#i-chevron"/></svg>Add a photo<span class="fine-print"><%= item.images.length %>/12</span></summary>
    <form method="post" action="<%= path %>/images" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><%- include('reference-fields',{type:'image',prefix:'new-image',values:!imageValues.id ? imageValues : {},validation:data.referenceError}) %><p class="fine-print">Use images you have permission to embed. External hosts see viewers’ IP addresses and may block or expire links. We suppress the referrer; we don’t download or proxy images.</p><div><button class="button primary" <%= item.images.length >= 12 ? 'disabled' : '' %>>Add photo</button></div></form>
  </details>
</section>